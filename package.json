{
  "name": "spotify-anonymous-api",
  "version": "1.0.0",
  "description": "A zero-dependency Node.js API that resolves Spotify metadata without official client credentials. Uses anonymous web-player token generation to query Spotify's internal GraphQL and public REST APIs.",
